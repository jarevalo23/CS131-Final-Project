.venv/
*.mp4
*.avi
*.mov
*.pt
*.dylib
*.so

# Ignore training run artifacts, but keep the directory tree traversable so the
# specific recovered weights below can be re-included (git can't un-ignore a file
# whose parent directory is ignored). See memory: trained-yolo-weights-in-git-history.
runs/**
!runs/**/
# Recovered trained weights (restored from git history) — keep these tracked so
# they are not silently deleted/ignored again.
!runs/detect/runs/basketball_players_yolov8n/weights/best.pt
!runs/detect/runs/court/nba_court_yolov8n/weights/best.pt
!runs/pose/runs/court_landmarks_pose/weights/best.pt
__pycache__/
*.pyc
*.DS_Store

# Pipeline outputs — generated files, not source
outputs/*.csv
outputs/*.jpg
outputs/*.png
data/

# Generated report figures (reproduced by running tests/report_analysis.py)
tests/report_figures/

# Local agent / editor config and internal working notes — not part of the submission
.claude/
STATUS.md